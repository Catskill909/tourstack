generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Museum {
  id          String       @id @default(cuid())
  name        String
  location    String?
  logo        String?
  branding    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  settings    AppSettings?
  collections Collection[]
  templates   Template[]
  tours       Tour[]
}

model Template {
  id           String   @id @default(cuid())
  museumId     String?
  name         String
  description  String
  icon         String
  builtIn      Boolean  @default(false)
  customFields String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  museum       Museum?  @relation(fields: [museumId], references: [id])
  tours        Tour[]
}

model Tour {
  id                         String    @id @default(cuid())
  slug                       String?
  museumId                   String
  templateId                 String
  status                     String    @default("draft")
  title                      String
  heroImage                  String
  description                String
  languages                  String
  primaryLanguage            String    @default("en")
  duration                   Int
  difficulty                 String    @default("general")
  defaultTranslationProvider String    @default("libretranslate")
  primaryPositioningMethod   String
  backupPositioningMethod    String?
  accessibility              String
  publishedAt                DateTime?
  scheduledPublishAt         DateTime?
  version                    Int       @default(1)
  conciergeEnabled           Boolean   @default(true)
  conciergePersona           String?
  conciergeWelcome           String?
  conciergeCollections       String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  conciergeQuickActions      String?
  conciergeChatIcon          String?
  conciergeChatIconBgColor   String?
  conciergeChatIconColor     String?
  stops                      Stop[]
  template                   Template  @relation(fields: [templateId], references: [id])
  museum                     Museum    @relation(fields: [museumId], references: [id])
}

model Stop {
  id                 String   @id @default(cuid())
  slug               String?
  tourId             String
  order              Int
  type               String   @default("mandatory")
  title              String
  image              String
  description        String
  customFieldValues  String
  primaryPositioning String
  backupPositioning  String?
  triggers           String
  content            String
  interactive        String?
  links              String
  accessibility      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tour               Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model AppSettings {
  id                 String   @id @default(cuid())
  museumId           String   @unique
  maps               String
  positioning        String
  media              String
  defaultLanguage    String   @default("en")
  supportedLanguages String
  analyticsEnabled   Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  museum             Museum   @relation(fields: [museumId], references: [id])
}

model Media {
  id             String   @id @default(cuid())
  filename       String
  mimeType       String
  size           Int
  url            String
  width          Int?
  height         Int?
  duration       Float?
  alt            String?
  caption        String?
  tags           String?
  aiMetadata     String?
  aiTranslations String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Collection {
  id             String   @id @default(cuid())
  museumId       String?
  name           String
  description    String?
  type           String   @default("gallery")
  items          String
  sourceLanguage String?
  texts          String?
  ttsSettings    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  museum         Museum?  @relation(fields: [museumId], references: [id])
}

model ConciergeConfig {
  id               String                 @id @default(cuid())
  museumId         String?
  enabled          Boolean                @default(false)
  persona          String                 @default("friendly")
  customPersona    String?
  welcomeMessage   String                 @default("{}")
  primaryLanguage  String                 @default("en")
  enabledLanguages String                 @default("[\"en\"]")
  autoTranslate    Boolean                @default(true)
  showNewChat      Boolean                @default(true)
  showSources      Boolean                @default(false)
  allowFeedback    Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  knowledgeSources ConciergeKnowledge[]
  quickActions     ConciergeQuickAction[]
}

model ConciergeKnowledge {
  id             String          @id @default(cuid())
  configId       String
  sourceType     String
  sourceId       String?
  title          String
  content        String
  characterCount Int
  enabled        Boolean         @default(true)
  priority       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  config         ConciergeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

model ConciergeQuickAction {
  id        String          @id @default(cuid())
  configId  String
  question  String
  category  String
  icon      String?
  order     Int             @default(0)
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  config    ConciergeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}
